[application]
config/name="Evertrail"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Chronicle Clash Link - Ninefold Mobile"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3")

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=4
window/size/mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":0)]}
shield={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventJoypadButton,"button_index":1)]}
item_a={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76),Object(InputEventJoypadButton,"button_index":2)]}
item_b={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73),Object(InputEventJoypadButton,"button_index":3)]}
pause_menu={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventKey,"physical_keycode":80),Object(InputEventJoypadButton,"button_index":6)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_mouse_from_touch=false

[gui]
common/drop_mouse_on_gui_input_disabled=true
